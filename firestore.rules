rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function currentMonthKey() {
      let month = request.time.month();
      return string(request.time.year()) + '-' +
        (month < 10 ? '0' : '') + string(month);
    }

    function previousMonthKey() {
      let month = request.time.month() == 1 ? 12 : request.time.month() - 1;
      let year = request.time.month() == 1
        ? request.time.year() - 1
        : request.time.year();
      return string(year) + '-' + (month < 10 ? '0' : '') + string(month);
    }

    function validMonth(monthKey) {
      return monthKey is string &&
        monthKey.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function activeMonth(monthKey) {
      return validMonth(monthKey) &&
        (monthKey == currentMonthKey() || monthKey == previousMonthKey());
    }

    function validPaymentPlan(type, planId, tokenAmount) {
      return (type == 'base' &&
          ((planId == 'basic' && tokenAmount == 50) ||
            (planId == 'standard' && tokenAmount == 110) ||
            (planId == 'pro' && tokenAmount == 170))) ||
        (type == 'addon' && planId == 'addon' && tokenAmount == 15);
    }

    function validUserCreation(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'tokens', 'subscriptions',
          'unlockedLessons'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'tokens', 'subscriptions',
          'unlockedLessons'
        ]) &&
        request.resource.data.uid == uid &&
        (request.resource.data.email == null ||
          request.resource.data.email is string) &&
        (request.resource.data.displayName == null ||
          request.resource.data.displayName is string) &&
        request.resource.data.tokens is map &&
        request.resource.data.tokens.keys().size() == 0 &&
        request.resource.data.subscriptions is map &&
        request.resource.data.subscriptions.keys().size() == 0 &&
        request.resource.data.unlockedLessons is map &&
        request.resource.data.unlockedLessons.keys().size() == 0;
    }

    function validUnlockForMonth(month) {
      let tokenMonths = request.resource.data.tokens
        .diff(resource.data.tokens).affectedKeys();
      let lessonMonths = request.resource.data.unlockedLessons
        .diff(resource.data.unlockedLessons).affectedKeys();
      let oldBalance = resource.data.tokens.get(month, 0);
      let newBalance = request.resource.data.tokens.get(month, 0);
      let oldLessons = resource.data.unlockedLessons.get(month, []);
      let newLessons = request.resource.data.unlockedLessons.get(month, []);
      return tokenMonths.hasOnly([month]) &&
        tokenMonths.hasAny([month]) &&
        lessonMonths.hasOnly([month]) &&
        lessonMonths.hasAny([month]) &&
        oldBalance is int && newBalance is int &&
        oldBalance > 0 && newBalance == oldBalance - 1 &&
        oldLessons is list && newLessons is list &&
        newLessons.size() == oldLessons.size() + 1 &&
        newLessons.hasAll(oldLessons);
    }

    function validUnlockUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['tokens', 'unlockedLessons']) &&
        request.resource.data.subscriptions == resource.data.subscriptions &&
        (validUnlockForMonth(currentMonthKey()) ||
          validUnlockForMonth(previousMonthKey()));
    }

    function removalOnly(oldMap, newMap) {
      let changes = newMap.diff(oldMap);
      return changes.removedKeys().size() > 0 &&
        changes.addedKeys().size() == 0 &&
        changes.changedKeys().size() == 0 &&
        !changes.removedKeys().hasAny([
          currentMonthKey(), previousMonthKey()
        ]);
    }

    function validPurgeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() > 0 &&
        changed.hasOnly(['tokens', 'subscriptions', 'unlockedLessons']) &&
        (!changed.hasAny(['tokens']) ||
          removalOnly(resource.data.tokens, request.resource.data.tokens)) &&
        (!changed.hasAny(['subscriptions']) ||
          removalOnly(resource.data.subscriptions,
            request.resource.data.subscriptions)) &&
        (!changed.hasAny(['unlockedLessons']) ||
          removalOnly(resource.data.unlockedLessons,
            request.resource.data.unlockedLessons));
    }

    function unchangedOrEmptyMap(fieldName) {
      return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny([fieldName]) ||
        ((!resource.data.keys().hasAny([fieldName]) ||
          resource.data.get(fieldName, null) == null) &&
          request.resource.data.get(fieldName, {}) is map &&
          request.resource.data.get(fieldName, {}).keys().size() == 0) ||
        request.resource.data.get(fieldName, {}) ==
          resource.data.get(fieldName, {});
    }

    function validProfileSync(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() > 0 &&
        changed.hasOnly([
          'email', 'displayName', 'tokens', 'subscriptions',
          'unlockedLessons'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.get('email', null) &&
        request.resource.data.displayName == request.auth.token.get('name', null) &&
        unchangedOrEmptyMap('tokens') &&
        unchangedOrEmptyMap('subscriptions') &&
        unchangedOrEmptyMap('unlockedLessons');
    }

    function validAdminCreditSubscription(payment, month) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let subscriptionMonths = request.resource.data.subscriptions
        .diff(resource.data.subscriptions).affectedKeys();
      let subscription = request.resource.data.subscriptions.get(month, {});
      return (payment.type == 'base' &&
          changed.hasAny(['subscriptions']) &&
          subscriptionMonths.hasOnly([month]) &&
          subscriptionMonths.hasAny([month]) &&
          subscription.keys().hasOnly([
            'planId', 'active', 'activatedAt'
          ]) &&
          subscription.keys().hasAll([
            'planId', 'active', 'activatedAt'
          ]) &&
          subscription.planId == payment.planId &&
          subscription.active == true &&
          subscription.activatedAt == request.time) ||
        (payment.type == 'addon' &&
          !changed.hasAny(['subscriptions']) &&
          resource.data.subscriptions.get(month, {}).get('active', false) ==
            true);
    }

    function validAdminCreditDetails(uid, payment, reviewed, month) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let tokenMonths = request.resource.data.tokens
        .diff(resource.data.tokens).affectedKeys();
      let oldBalance = resource.data.tokens.get(month, 0);
      let newBalance = request.resource.data.tokens.get(month, 0);
      return isAdmin() &&
        payment.userId == uid &&
        payment.status == 'pending' &&
        reviewed.status == 'approved' &&
        reviewed.approvedBy == request.auth.uid &&
        reviewed.approvedAt == request.time &&
        activeMonth(month) &&
        validPaymentPlan(payment.type, payment.planId, payment.tokenAmount) &&
        changed.hasOnly(['tokens', 'subscriptions', 'lastPaymentRequestId']) &&
        changed.hasAll(['tokens', 'lastPaymentRequestId']) &&
        request.resource.data.lastPaymentRequestId is string &&
        request.resource.data.lastPaymentRequestId.size() > 0 &&
        tokenMonths.hasOnly([month]) &&
        tokenMonths.hasAny([month]) &&
        oldBalance is int && newBalance is int &&
        newBalance == oldBalance + payment.tokenAmount &&
        validAdminCreditSubscription(payment, month);
    }

    function validAdminCredit(uid) {
      let approvalId = request.resource.data.get('lastPaymentRequestId', null);
      let paymentPath =
        /databases/$(database)/documents/payment_requests/$(approvalId);
      let payment = get(paymentPath).data;
      let reviewed = getAfter(paymentPath).data;
      let month = payment.targetMonth;
      return approvalId is string &&
        approvalId != resource.data.get('lastPaymentRequestId', null) &&
        validAdminCreditDetails(uid, payment, reviewed, month);
    }

    function validPaymentRequest() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'userId', 'userEmail', 'type', 'planId', 'tokenAmount',
          'targetMonth', 'senderPhone', 'tid', 'status', 'createdAt'
        ]) &&
        data.keys().hasAll([
          'userId', 'userEmail', 'type', 'planId', 'tokenAmount',
          'targetMonth', 'senderPhone', 'tid', 'status', 'createdAt'
        ]) &&
        data.userId == request.auth.uid &&
        (data.userEmail == null || data.userEmail is string) &&
        data.type in ['base', 'addon'] &&
        data.planId is string &&
        data.tokenAmount is int &&
        activeMonth(data.targetMonth) &&
        data.senderPhone is string &&
        data.senderPhone.matches('^[0-9]{11}$') &&
        data.tid is string &&
        data.tid.matches('^[A-Z0-9]{11}$') &&
        data.status == 'pending' &&
        data.createdAt == request.time;
    }

    function validAdminRequestReview(requestId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let payment = resource.data;
      let reviewed = request.resource.data;
      let userPath = /databases/$(database)/documents/users/$(payment.userId);
      let receiptPath =
        /databases/$(database)/documents/payment_receipts/$(payment.tid);
      let userAfter = getAfter(userPath).data;
      let receiptAfter = getAfter(receiptPath).data;
      let isApproval = reviewed.status == 'approved' &&
        changed.hasOnly(['status', 'approvedAt', 'approvedBy']) &&
        reviewed.approvedAt == request.time &&
        reviewed.approvedBy == request.auth.uid &&
        existsAfter(userPath) &&
        userAfter.get('lastPaymentRequestId', null) == requestId &&
        existsAfter(receiptPath) &&
        receiptAfter.paymentRequestId == requestId &&
        receiptAfter.userId == payment.userId &&
        receiptAfter.approvedBy == request.auth.uid;
      let isRejection = reviewed.status == 'rejected' &&
        changed.hasOnly(['status', 'rejectedAt', 'rejectedBy']) &&
        reviewed.rejectedAt == request.time &&
        reviewed.rejectedBy == request.auth.uid;
      return isAdmin() &&
        resource.data.status == 'pending' &&
        requestId is string &&
        (isApproval || isRejection);
    }

    function validPaymentReceipt(tid) {
      let data = request.resource.data;
      let paymentPath =
        /databases/$(database)/documents/payment_requests/$(data.paymentRequestId);
      let payment = get(paymentPath).data;
      let reviewed = getAfter(paymentPath).data;
      return isAdmin() &&
        data.keys().hasOnly([
          'paymentRequestId', 'userId', 'approvedBy', 'createdAt'
        ]) &&
        data.keys().hasAll([
          'paymentRequestId', 'userId', 'approvedBy', 'createdAt'
        ]) &&
        data.userId is string &&
        data.approvedBy == request.auth.uid &&
        data.createdAt == request.time &&
        payment.status == 'pending' &&
        reviewed.status == 'approved' &&
        reviewed.approvedBy == request.auth.uid &&
        payment.userId == data.userId &&
        payment.tid == tid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        validUserCreation(uid);
      allow update: if signedIn() &&
        ((request.auth.uid == uid &&
            (validUnlockUpdate() ||
              validPurgeUpdate() ||
              validProfileSync(uid))) ||
          validAdminCredit(uid));
      allow delete: if false;
    }

    match /payment_requests/{requestId} {
      allow create: if signedIn() && validPaymentRequest();
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if validAdminRequestReview(requestId);
      allow delete: if false;
    }

    match /payment_receipts/{tid} {
      allow read: if isAdmin();
      allow create: if validPaymentReceipt(tid);
      allow update, delete: if false;
    }
  }
}
